# Local development environment variables.
# Copy to `.env` and fill in the values for your backend project.
# These same names must exist as GitHub Actions secrets for CI builds.

# Required — backend project URL (https://<project-ref>.supabase.co)
VITE_SUPABASE_URL=

# Required — publishable (anon) API key used by the browser client.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional — legacy alias. Used only as a fallback when
# VITE_SUPABASE_PUBLISHABLE_KEY is not set (keeps CI and local builds in sync).
VITE_SUPABASE_ANON_KEY=

# Optional — backend project ref/id, used by tooling and scripts.
VITE_SUPABASE_PROJECT_ID=

# Optional — crash reporting.
VITE_SENTRY_DSN=
# Optional — release tag for Sentry (CI sets this to the commit SHA).
VITE_APP_VERSION=
